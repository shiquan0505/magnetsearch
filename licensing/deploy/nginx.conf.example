# Nginx 反向代理 + HTTPS（生产必须 HTTPS，二维码里的支付链接也要走 https）
server {
    listen 443 ssl http2;
    server_name lic.example.com;

    ssl_certificate     /etc/letsencrypt/live/lic.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lic.example.com/privkey.pem;

    # 客户端会话/下单
    location /api/ {
        proxy_pass http://127.0.0.1:8899;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # 支付平台回调：不要加鉴权、不要缓存
    location /notify/ {
        proxy_pass http://127.0.0.1:8899;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
    }

    # 收款页 / 后台
    location / {
        proxy_pass http://127.0.0.1:8899;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 后台只允许你自己的 IP（强烈建议开）
    location /admin {
        allow 1.2.3.4;
        deny all;
        proxy_pass http://127.0.0.1:8899;
        proxy_set_header Host $host;
    }
}

server {
    listen 80;
    server_name lic.example.com;
    return 301 https://$host$request_uri;
}
